# App Config
SECRET_KEY=supersecretjwtkeythatshouldbechangedinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default PostgreSQL URL. Set your host, port, username, password, and database name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_video_summarizer

# AI API Keys
# Hugging Face Token for free Inference API models (e.g., Llama-3-8B-Instruct)
HF_API_TOKEN=
# Gemini API Key (free tier Google AI Studio)
GEMINI_API_KEY=
# OpenAI API Key (if Whisper API or GPT is preferred)
OPENAI_API_KEY=

# Storage Directory overrides (relative to project root or absolute paths)
UPLOADS_DIR=uploads
HIGHLIGHTS_DIR=highlights
SUMMARIES_DIR=summaries
TRANSCRIPTS_DIR=transcripts
